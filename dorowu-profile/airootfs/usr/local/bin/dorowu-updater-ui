#!/usr/bin/env python3
"""
Dorowu OS Real System & Application Desktop GUI Updater
Built natively for Dorowu OS (Arch Linux / KDE Plasma 6)
"""

import os
import sys
import subprocess
import threading
import time

# Fallback to CLI mode if no graphical display is found (e.g. pure TTY or SSH)
if not os.environ.get("DISPLAY") and not os.environ.get("WAYLAND_DISPLAY"):
    cli_candidates = [
        "/usr/local/bin/dorowu-update",
        os.path.join(os.path.dirname(os.path.abspath(__file__)), "dorowu-update")
    ]
    cli_bin = next((c for c in cli_candidates if os.path.exists(c)), None)
    if cli_bin:
        os.execv(cli_bin, [cli_bin] + sys.argv[1:])
    else:
        print("Dorowu Updater: No graphical display found and dorowu-update CLI missing.", file=sys.stderr)
        sys.exit(1)

import tkinter as tk
from tkinter import ttk, messagebox

class DorowuUpdaterApp(tk.Tk):
    def __init__(self):
        super().__init__()

        self.title("Dorowu OS — System & Application Updater")
        self.geometry("900x640")
        self.minsize(700, 500)

        # Breeze Dark Theme Palette
        self.bg_root = "#181a1c"
        self.bg_card = "#22252a"
        self.bg_item = "#1c1f24"
        self.bg_term = "#0d0e10"
        self.fg_primary = "#eff0f1"
        self.fg_secondary = "#a0a6ad"
        self.accent_cyan = "#3daee9"
        self.accent_green = "#2ecc71"
        self.accent_amber = "#f39c12"
        self.accent_red = "#e74c3c"
        self.border_color = "#2c313a"

        self.configure(bg=self.bg_root)

        # Set WM Class and Window Icon
        try:
            self.wm_class("dorowu-updater-ui", "Dorowu-updater-ui")
        except Exception:
            pass
        self._setup_window_icon()

        # State
        self.is_running = False
        self.pending_updates = []
        self.update_system_var = tk.BooleanVar(value=True)
        self.update_apps_var = tk.BooleanVar(value=True)
        self.update_keyring_var = tk.BooleanVar(value=True)
        self.clean_cache_var = tk.BooleanVar(value=True)

        self._build_ui()

        # Auto-trigger an initial check in background
        self.after(300, self.start_check_updates)

    def _setup_window_icon(self):
        icon_candidates = [
            "/usr/share/pixmaps/dorowu-updater.png",
            "/usr/share/icons/hicolor/256x256/apps/dorowu-updater.png",
            "/usr/share/pixmaps/dorowu-logo.png",
            os.path.join(os.path.dirname(os.path.abspath(__file__)), "../../share/pixmaps/dorowu-updater.png"),
        ]
        for p in icon_candidates:
            if os.path.exists(p):
                try:
                    img = tk.PhotoImage(file=p)
                    self.iconphoto(True, img)
                    self._window_icon = img
                    break
                except Exception:
                    continue

    def _build_ui(self):
        self.grid_columnconfigure(0, weight=1)
        self.grid_rowconfigure(2, weight=1)

        # ----------------- 1. HEADER -----------------
        header_frame = tk.Frame(self, bg=self.bg_card, padx=20, pady=16)
        header_frame.grid(row=0, column=0, sticky="ew")

        title_box = tk.Frame(header_frame, bg=self.bg_card)
        title_box.pack(side="left", fill="both")

        lbl_title = tk.Label(
            title_box,
            text="Dorowu OS System & Application Updater",
            font=("Segoe UI", 15, "bold"),
            fg=self.fg_primary,
            bg=self.bg_card
        )
        lbl_title.pack(anchor="w")

        lbl_sub = tk.Label(
            title_box,
            text="Real rolling upgrade engine for Arch Linux core, KDE Plasma 6, and Flatpak desktop apps",
            font=("Segoe UI", 9),
            fg=self.fg_secondary,
            bg=self.bg_card
        )
        lbl_sub.pack(anchor="w", pady=(2, 0))

        self.lbl_status_badge = tk.Label(
            header_frame,
            text="Ready to Check",
            font=("Segoe UI", 9, "bold"),
            fg=self.accent_cyan,
            bg=self.bg_item,
            padx=10,
            pady=4,
            relief="solid",
            bd=1
        )
        self.lbl_status_badge.pack(side="right", padx=(10, 0))

        # ----------------- 2. ACTION CONTROLS & OPTIONS -----------------
        control_frame = tk.Frame(self, bg=self.bg_root, padx=20, pady=12)
        control_frame.grid(row=1, column=0, sticky="ew")

        # Buttons
        btn_box = tk.Frame(control_frame, bg=self.bg_root)
        btn_box.pack(side="left")

        self.btn_check = tk.Button(
            btn_box,
            text="🔄  Check for Updates",
            font=("Segoe UI", 10, "bold"),
            bg=self.bg_card,
            fg=self.fg_primary,
            activebackground=self.bg_item,
            activeforeground=self.accent_cyan,
            relief="flat",
            padx=14,
            pady=6,
            cursor="hand2",
            command=self.start_check_updates
        )
        self.btn_check.pack(side="left", padx=(0, 10))

        self.btn_update = tk.Button(
            btn_box,
            text="⚡  Install All Updates",
            font=("Segoe UI", 10, "bold"),
            bg=self.accent_cyan,
            fg="#0b1728",
            activebackground="#56c0f5",
            activeforeground="#000000",
            relief="flat",
            padx=16,
            pady=6,
            cursor="hand2",
            command=self.start_apply_updates
        )
        self.btn_update.pack(side="left")

        # Toggles
        opt_box = tk.Frame(control_frame, bg=self.bg_root)
        opt_box.pack(side="right")

        chk_sys = tk.Checkbutton(
            opt_box,
            text="Arch System (pacman)",
            variable=self.update_system_var,
            bg=self.bg_root,
            fg=self.fg_primary,
            selectcolor=self.bg_card,
            activebackground=self.bg_root,
            activeforeground=self.accent_cyan,
            font=("Segoe UI", 8)
        )
        chk_sys.pack(side="left", padx=5)

        chk_apps = tk.Checkbutton(
            opt_box,
            text="Desktop Apps (flatpak)",
            variable=self.update_apps_var,
            bg=self.bg_root,
            fg=self.fg_primary,
            selectcolor=self.bg_card,
            activebackground=self.bg_root,
            activeforeground=self.accent_cyan,
            font=("Segoe UI", 8)
        )
        chk_apps.pack(side="left", padx=5)

        # ----------------- 3. MAIN WORKSPACE (SPLIT: LIST & TERMINAL) -----------------
        main_frame = tk.Frame(self, bg=self.bg_root, padx=20, pady=4)
        main_frame.grid(row=2, column=0, sticky="nsew")
        main_frame.grid_columnconfigure(0, weight=1)
        main_frame.grid_rowconfigure(0, weight=1)
        main_frame.grid_rowconfigure(1, weight=1)

        # Top section: Available updates list
        list_container = tk.Frame(main_frame, bg=self.bg_card, relief="solid", bd=1)
        list_container.grid(row=0, column=0, sticky="nsew", pady=(0, 8))
        list_container.grid_columnconfigure(0, weight=1)
        list_container.grid_rowconfigure(1, weight=1)

        list_header = tk.Frame(list_container, bg=self.bg_item, padx=12, pady=6)
        list_header.grid(row=0, column=0, sticky="ew")

        self.lbl_list_count = tk.Label(
            list_header,
            text="Available Updates (0)",
            font=("Segoe UI", 9, "bold"),
            fg=self.accent_cyan,
            bg=self.bg_item
        )
        self.lbl_list_count.pack(side="left")

        # Treeview / List
        tree_scroll = tk.Scrollbar(list_container)
        tree_scroll.grid(row=1, column=1, sticky="ns")

        style = ttk.Style()
        style.theme_use("clam")
        style.configure("Treeview",
                        background=self.bg_card,
                        foreground=self.fg_primary,
                        fieldbackground=self.bg_card,
                        rowheight=24,
                        font=("Segoe UI", 9))
        style.configure("Treeview.Heading",
                        background=self.bg_item,
                        foreground=self.accent_cyan,
                        font=("Segoe UI", 9, "bold"))
        style.map("Treeview", background=[("selected", "#1a3b5c")])

        self.tree = ttk.Treeview(
            list_container,
            columns=("type", "package", "old_ver", "new_ver"),
            show="headings",
            yscrollcommand=tree_scroll.set
        )
        self.tree.heading("type", text="Type")
        self.tree.heading("package", text="Package / Application")
        self.tree.heading("old_ver", text="Installed")
        self.tree.heading("new_ver", text="Target Version")

        self.tree.column("type", width=90, anchor="center")
        self.tree.column("package", width=340, anchor="w")
        self.tree.column("old_ver", width=180, anchor="w")
        self.tree.column("new_ver", width=180, anchor="w")

        self.tree.grid(row=1, column=0, sticky="nsew")
        tree_scroll.config(command=self.tree.yview)

        # Bottom section: Live terminal log output
        term_container = tk.Frame(main_frame, bg=self.bg_term, relief="solid", bd=1)
        term_container.grid(row=1, column=0, sticky="nsew")
        term_container.grid_columnconfigure(0, weight=1)
        term_container.grid_rowconfigure(1, weight=1)

        term_header = tk.Frame(term_container, bg="#121417", padx=12, pady=5)
        term_header.grid(row=0, column=0, sticky="ew")

        lbl_term_title = tk.Label(
            term_header,
            text="Update Progress & Terminal Output",
            font=("Segoe UI", 9, "bold"),
            fg=self.fg_secondary,
            bg="#121417"
        )
        lbl_term_title.pack(side="left")

        term_scroll = tk.Scrollbar(term_container)
        term_scroll.grid(row=1, column=1, sticky="ns")

        self.txt_term = tk.Text(
            term_container,
            bg=self.bg_term,
            fg="#d1d5db",
            insertbackground=self.accent_cyan,
            font=("JetBrains Mono", 9),
            wrap="word",
            relief="flat",
            padx=10,
            pady=8,
            yscrollcommand=term_scroll.set
        )
        self.txt_term.grid(row=1, column=0, sticky="nsew")
        term_scroll.config(command=self.txt_term.yview)

        self.txt_term.tag_configure("info", foreground="#38bdf8")
        self.txt_term.tag_configure("success", foreground="#4ade80")
        self.txt_term.tag_configure("warn", foreground="#fbbf24")
        self.txt_term.tag_configure("error", foreground="#f87171")
        self.txt_term.tag_configure("dim", foreground="#6b7280")

        # ----------------- 4. FOOTER -----------------
        footer = tk.Frame(self, bg=self.bg_root, padx=20, pady=8)
        footer.grid(row=3, column=0, sticky="ew")

        lbl_footer_info = tk.Label(
            footer,
            text="Arch Linux Repositories: [core] [extra] [multilib] • Flatpak Remote: [flathub]",
            font=("Segoe UI", 8),
            fg=self.fg_secondary,
            bg=self.bg_root
        )
        lbl_footer_info.pack(side="left")

        self.lbl_last_checked = tk.Label(
            footer,
            text="Not checked yet",
            font=("Segoe UI", 8),
            fg=self.fg_secondary,
            bg=self.bg_root
        )
        self.lbl_last_checked.pack(side="right")

    def log(self, text, tag="info"):
        self.txt_term.insert("end", text + "\n", tag)
        self.txt_term.see("end")

    def set_badge(self, text, color):
        self.lbl_status_badge.config(text=text, fg=color)

    # ----------------- CHECK FOR UPDATES -----------------
    def start_check_updates(self):
        if self.is_running:
            return
        self.is_running = True
        self.btn_check.config(state="disabled")
        self.btn_update.config(state="disabled")
        self.set_badge("Checking Updates...", self.accent_amber)
        self.log("\n[Dorowu Updater] Checking official Arch repositories and Flathub...", "info")

        threading.Thread(target=self._run_check_thread, daemon=True).start()

    def _run_check_thread(self):
        updates_list = []
        try:
            # 1. Check Arch System Updates via checkupdates
            if subprocess.call("command -v checkupdates >/dev/null 2>&1", shell=True) == 0:
                res = subprocess.run(["checkupdates"], capture_output=True, text=True)
                for line in res.stdout.strip().splitlines():
                    if not line.strip():
                        continue
                    parts = line.split()
                    if len(parts) >= 3:
                        pkg = parts[0]
                        old_v = parts[1]
                        new_v = parts[2] if parts[2] != "->" and len(parts) < 4 else (parts[3] if len(parts) >= 4 else parts[2])
                        updates_list.append(("System (pacman)", pkg, old_v, new_v))
            else:
                # pacman -Qu
                res = subprocess.run(["pacman", "-Qu"], capture_output=True, text=True)
                for line in res.stdout.strip().splitlines():
                    if not line.strip():
                        continue
                    parts = line.split()
                    if len(parts) >= 3:
                        pkg = parts[0]
                        old_v = parts[1]
                        new_v = parts[2] if parts[2] != "->" and len(parts) < 4 else (parts[3] if len(parts) >= 4 else parts[2])
                        updates_list.append(("System (pacman)", pkg, old_v, new_v))

            # 2. Check Flatpak updates
            if subprocess.call("command -v flatpak >/dev/null 2>&1", shell=True) == 0:
                res_flat = subprocess.run(["flatpak", "remote-ls", "--updates"], capture_output=True, text=True)
                for line in res_flat.stdout.strip().splitlines():
                    if not line.strip():
                        continue
                    parts = line.split()
                    app_id = parts[0]
                    ver = parts[1] if len(parts) > 1 else "latest"
                    updates_list.append(("Desktop App", app_id, "current", ver))

        except Exception as e:
            self.after(0, lambda: self.log(f"Check encountered warning: {e}", "warn"))

        self.after(0, lambda: self._on_check_finished(updates_list))

    def _on_check_finished(self, updates_list):
        self.is_running = False
        self.btn_check.config(state="normal")
        self.btn_update.config(state="normal")

        # Clear existing tree
        for item in self.tree.get_children():
            self.tree.delete(item)

        self.pending_updates = updates_list
        count = len(updates_list)
        self.lbl_list_count.config(text=f"Available Updates ({count})")
        self.lbl_last_checked.config(text=f"Last checked: {time.strftime('%H:%M:%S')}")

        if count == 0:
            self.set_badge("System Up to Date ✓", self.accent_green)
            self.log("All Dorowu OS system packages and desktop applications are completely up to date.", "success")
        else:
            self.set_badge(f"{count} Updates Available", self.accent_amber)
            self.log(f"Found {count} update(s) ready to install.", "warn")
            for item in updates_list:
                self.tree.insert("", "end", values=item)

    # ----------------- APPLY UPDATES -----------------
    def start_apply_updates(self):
        if self.is_running:
            return

        self.is_running = True
        self.btn_check.config(state="disabled")
        self.btn_update.config(state="disabled")
        self.set_badge("Upgrading System...", self.accent_cyan)

        threading.Thread(target=self._run_apply_thread, daemon=True).start()

    def _run_apply_thread(self):
        self.after(0, lambda: self.log("\n=======================================================", "info"))
        self.after(0, lambda: self.log("Starting Dorowu OS real upgrade process...", "info"))

        cmd = ["dorowu-update"]
        if not self.update_system_var.get() and self.update_apps_var.get():
            cmd.append("--apps-only")
        elif self.update_system_var.get() and not self.update_apps_var.get():
            cmd.append("--system-only")

        if not os.path.exists("/usr/local/bin/dorowu-update"):
            # Execute direct pacman / flatpak calls
            cmd = ["pkexec", "pacman", "-Syu", "--noconfirm"]

        try:
            # Use pkexec if GUI to prompt for root password gracefully
            exec_cmd = ["pkexec"] + cmd if os.geteuid() != 0 else cmd
            process = subprocess.Popen(
                exec_cmd,
                stdout=subprocess.PIPE,
                stderr=subprocess.STDOUT,
                text=True,
                bufsize=1
            )
            for line in iter(process.stdout.readline, ''):
                clean_line = line.strip()
                if clean_line:
                    self.after(0, lambda cl=clean_line: self.log(cl, "dim"))
            process.stdout.close()
            ret = process.wait()

            if ret == 0:
                self.after(0, lambda: self._on_apply_finished(True))
            else:
                self.after(0, lambda: self._on_apply_finished(False, f"Process exited with code {ret}"))
        except Exception as e:
            self.after(0, lambda: self._on_apply_finished(False, str(e)))

    def _on_apply_finished(self, success, err_msg=""):
        self.is_running = False
        self.btn_check.config(state="normal")
        self.btn_update.config(state="normal")

        if success:
            self.set_badge("Upgrade Complete ✓", self.accent_green)
            self.log("Successfully upgraded Dorowu OS system and applications!", "success")
            self.after(500, self.start_check_updates)
        else:
            self.set_badge("Update Paused / Error", self.accent_red)
            self.log(f"Update completed with notes: {err_msg}", "warn")

if __name__ == "__main__":
    app = DorowuUpdaterApp()
    app.mainloop()
